{
  "name": "doctrack",
  "version": "0.1.8",
  "description": "Cross-platform document management and tracking workspace application.",
  "private": true,
  "homepage": "https://github.com/zaferaltan/DocTrack",
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zaferaltan/DocTrack.git"
  },
  "scripts": {
    "dev": "npm run rebuild:native && electron-vite dev",
    "build": "npm run rebuild:native && electron-vite build",
    "preview": "npm run rebuild:native && electron-vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:win:compat": "npm run build && electron-builder --win nsis --x64 --publish never --config.win.signAndEditExecutable=false",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
    "release": "npm run build && electron-builder --publish always",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "release:win:compat": "npm run build && electron-builder --win nsis --x64 --publish always --config.win.signAndEditExecutable=false",
    "release:mac": "npm run build && electron-builder --mac dmg zip --universal --publish always",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "npm run rebuild:node && vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.2"
  }
}
